//===----------------------------------------------------------------------===//
// TTKernel per-op MATH init bindings.
//===----------------------------------------------------------------------===//
//
// The single table of compute operation -> per-op init. Effects and init
// insertion both include this file.
//
//   MATH_INIT_AUTO(COMPUTE, INIT, COPS, IOPS, ATTRS, EXP)
//     INIT is created with no operands or attributes.
//   MATH_INIT_MANUAL(COMPUTE, INIT, COPS, IOPS, ATTRS, EXP)
//     Insertion supplies a custom builder. COPS and IOPS are the key operand
//     indices of the compute op and the init op. ATTRS is the attribute list.
//     EXP is 1 when omitted exp flags take the metal defaults.
//
// MatmulTilesOp is omitted: its transpose is an operand of mm_init_short and
// does not exist on matmul_tiles. RandTileOp is omitted: the PRNG seed exists
// only on rand_tile_init. ExperimentalRowNormalizationBlockOp and
// InvokeSFPIOp are not rows; they write an unknown MATH configuration.
//
//===----------------------------------------------------------------------===//

#ifndef MATH_INIT_AUTO
#define MATH_INIT_AUTO(COMPUTE, INIT, COPS, IOPS, ATTRS, EXP)
#endif
#ifndef MATH_INIT_MANUAL
#define MATH_INIT_MANUAL(COMPUTE, INIT, COPS, IOPS, ATTRS, EXP)
#endif

#define TTL_UNARY_TILE_OP(TTL_OP, TILE_OP, TTK_INIT, TTK_COMPUTE)              \
  MATH_INIT_AUTO(TTK_COMPUTE, TTK_INIT, none, none, noAttrs(), 0)
#define TTL_BINARY_TILE_OP(TTL_OP, TILE_OP, TTK_INIT, TTK_COMPUTE)             \
  MATH_INIT_AUTO(TTK_COMPUTE, TTK_INIT, none, none, noAttrs(), 0)
#define TTL_BINARY_TILE_OP_MINMAX(TTL_OP, TILE_OP, TTK_INIT, TTK_COMPUTE)      \
  MATH_INIT_AUTO(TTK_COMPUTE, TTK_INIT, none, none, noAttrs(), 0)
#define TTL_FPU_BINARY_TILE_OP(TTL_OP, TILE_OP, TTK_INIT, TTK_COMPUTE)         \
  MATH_INIT_MANUAL(TTK_COMPUTE, TTK_INIT, c01, i01, noAttrs(), 0)
#include "ttlang/Dialect/TTL/TTLElementwiseOps.def"

