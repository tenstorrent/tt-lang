# tt-emule JITs Linux/x86-64 shared objects, so this image intentionally uses
# the amd64 TT-Lang IRD toolchain on every host, including Apple Silicon.
ARG BASE_IMAGE=ghcr.io/tenstorrent/tt-lang/tt-lang-ird-ubuntu-24-04@sha256:0713f01120e3a63279e39585380429d235a65df02faa14694cb4d914538838ff
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]

ARG TT_EMULE_COMMIT=07f1bd8301544403c8bc1faa4038f6cbf69909f1
ARG TT_METAL_COMMIT=d48d09dee19de51f694a52fdf75d569950d38ceb

ENV DEBIAN_FRONTEND=noninteractive
ENV TT_EMULE_RUNTIME_ROOT=/opt/tt-emule-runtime
ENV TT_METAL_SOURCE_DIR=/opt/tt-emule-runtime/tt-metal
ENV TT_METAL_BUILD_DIR=/opt/tt-emule-runtime/tt-metal/build_emule

RUN apt-get update && apt-get install -y --no-install-recommends \
        binutils \
        ca-certificates \
        cmake \
        g++-13 \
        gcc-13 \
        git \
        ninja-build \
    && rm -rf /var/lib/apt/lists/* \
    && command -v clang-20 >/dev/null \
    && command -v clang++-20 >/dev/null \
    && command -v lld-20 >/dev/null

RUN mkdir -p "$TT_EMULE_RUNTIME_ROOT" \
    && git init /opt/tt-emule \
    && git -C /opt/tt-emule remote add origin https://github.com/tenstorrent/tt-emule.git \
    && git -C /opt/tt-emule fetch --depth 1 origin "$TT_EMULE_COMMIT" \
    && git -C /opt/tt-emule checkout --detach FETCH_HEAD \
    && git init "$TT_METAL_SOURCE_DIR" \
    && git -C "$TT_METAL_SOURCE_DIR" remote add origin https://github.com/tenstorrent/tt-metal.git \
    && git -C "$TT_METAL_SOURCE_DIR" fetch --depth 1 origin "$TT_METAL_COMMIT" \
    && git -C "$TT_METAL_SOURCE_DIR" checkout --detach FETCH_HEAD \
    && git -C "$TT_METAL_SOURCE_DIR" submodule update --init --depth 1 \
        tt_metal/third_party/umd tt_metal/third_party/tracy

RUN cmake -S "$TT_METAL_SOURCE_DIR" -B "$TT_METAL_BUILD_DIR" -G Ninja \
        -DCMAKE_TOOLCHAIN_FILE="$TT_METAL_SOURCE_DIR/cmake/x86_64-linux-clang-20-libstdcpp-toolchain.cmake" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="$TT_METAL_BUILD_DIR" \
        -DPython3_EXECUTABLE=/opt/ttlang-toolchain/venv/bin/python \
        -DTT_METAL_USE_EMULE=ON \
        -DTT_EMULE_PATH=/opt/tt-emule \
        -DWITH_PYTHON_BINDINGS=ON \
        -DTT_UNITY_BUILDS=ON \
        -DENABLE_TRACY=OFF \
        -DENABLE_DISTRIBUTED=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_PROGRAMMING_EXAMPLES=OFF \
        -DTT_METAL_BUILD_TESTS=OFF \
        -DTTNN_BUILD_TESTS=OFF \
        -DBUILD_TT_TRAIN=OFF \
        -DBUILD_TELEMETRY=OFF \
        -DENABLE_TTNN_SHARED_SUBLIBS=OFF \
        -DTT_ENABLE_LIGHT_METAL_TRACE=OFF \
        -DENABLE_LIBCXX=OFF \
    && TT_METAL_HOME="$TT_METAL_SOURCE_DIR" \
       TT_METAL_RUNTIME_ROOT="$TT_METAL_SOURCE_DIR" \
       TT_METAL_CACHE="$TT_METAL_BUILD_DIR/tt-metal-cache" \
       cmake --build "$TT_METAL_BUILD_DIR" --target ttnn ttnncpp \
    && TT_METAL_HOME="$TT_METAL_SOURCE_DIR" \
       TT_METAL_RUNTIME_ROOT="$TT_METAL_SOURCE_DIR" \
       TT_METAL_CACHE="$TT_METAL_BUILD_DIR/tt-metal-cache" \
       cmake --build "$TT_METAL_BUILD_DIR" --target precompile-fw --parallel 1 \
    && ln -sfn "$TT_METAL_BUILD_DIR/ttnn/_ttnn.so" \
        "$TT_METAL_SOURCE_DIR/ttnn/ttnn/_ttnn.so" \
    && mkdir -p "$TT_METAL_BUILD_DIR/lib" \
    && ln -sfn ../tt_metal/libtt_metal.so "$TT_METAL_BUILD_DIR/lib/libtt_metal.so" \
    && ln -sfn ../tt_stl/libtt_stl.so "$TT_METAL_BUILD_DIR/lib/libtt_stl.so" \
    && ln -sfn ../ttnn/_ttnncpp.so "$TT_METAL_BUILD_DIR/lib/_ttnncpp.so" \
    && ln -sfn ../ttnn/_ttnn.so "$TT_METAL_BUILD_DIR/lib/_ttnn.so" \
    && nm -DC "$TT_METAL_BUILD_DIR/tt_metal/libtt_metal.so" \
        > /tmp/tt-metal-symbols.txt \
    && grep -q 'emule::execute_program_emulated' /tmp/tt-metal-symbols.txt \
    && rm /tmp/tt-metal-symbols.txt \
    && TT_METAL_HOME="$TT_METAL_SOURCE_DIR" \
       TT_METAL_RUNTIME_ROOT="$TT_METAL_SOURCE_DIR" \
       PYTHONPATH="$TT_METAL_SOURCE_DIR/ttnn:$TT_METAL_SOURCE_DIR/tools" \
       /opt/ttlang-toolchain/venv/bin/python -c 'import ttnn'

COPY tt-lang-emule-entrypoint.sh /usr/local/bin/tt-lang-emule-entrypoint
RUN chmod +x /usr/local/bin/tt-lang-emule-entrypoint \
    && mkdir -p /ttlang-build /tt-metal-cache

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/tt-lang-emule-entrypoint"]
