# tt-emule JITs Linux/x86-64 shared objects, so this image intentionally uses
# the amd64 TT-Lang IRD toolchain on every host, including Apple Silicon.
ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS build

SHELL ["/bin/bash", "-c"]

ARG BASE_IMAGE
ARG STACK_MANIFEST_SHA256
ARG TT_LANG_COMPILER_REPOSITORY
ARG TT_LANG_COMPILER_BASE_COMMIT
ARG TT_EMULE_COMMIT
ARG TT_METAL_COMMIT
ARG TT_METAL_SOURCE_URL
ARG RUNTIME_PLATFORM
ARG TARGET_NAME
ARG TARGET_CLUSTER_DESCRIPTOR
ARG TARGET_MESH_DEVICE

LABEL org.opencontainers.image.title="TT-Lang compiler-backed emule runtime" \
      org.opencontainers.image.source="${TT_LANG_COMPILER_REPOSITORY}" \
      io.tenstorrent.tt-lang.compiler.commit="${TT_LANG_COMPILER_BASE_COMMIT}" \
      io.tenstorrent.tt-lang.emule.commit="${TT_EMULE_COMMIT}" \
      io.tenstorrent.tt-lang.metal.repository="${TT_METAL_SOURCE_URL}" \
      io.tenstorrent.tt-lang.metal.commit="${TT_METAL_COMMIT}" \
      io.tenstorrent.tt-lang.runtime.base-image="${BASE_IMAGE}" \
      io.tenstorrent.tt-lang.runtime.manifest-sha256="${STACK_MANIFEST_SHA256}" \
      io.tenstorrent.tt-lang.runtime.platform="${RUNTIME_PLATFORM}" \
      io.tenstorrent.tt-lang.target.name="${TARGET_NAME}" \
      io.tenstorrent.tt-lang.target.cluster-descriptor="${TARGET_CLUSTER_DESCRIPTOR}" \
      io.tenstorrent.tt-lang.target.mesh-device="${TARGET_MESH_DEVICE}"

ENV DEBIAN_FRONTEND=noninteractive
ENV TT_EMULE_RUNTIME_ROOT=/opt/tt-emule-runtime
ENV TT_METAL_SOURCE_DIR=/opt/tt-emule-runtime/tt-metal
ENV TT_METAL_BUILD_DIR=/opt/tt-emule-runtime/tt-metal/build_emule

RUN apt-get update && apt-get install -y --no-install-recommends \
        binutils \
        ca-certificates \
        cmake \
        g++-13 \
        gcc-13 \
        git \
        ninja-build \
    && rm -rf /var/lib/apt/lists/* \
    && command -v clang-20 >/dev/null \
    && command -v clang++-20 >/dev/null \
    && command -v lld-20 >/dev/null

COPY --from=tt-emule-source . /opt/tt-emule
COPY --from=tt-lang-stack tt-lang-emule-stack.json \
    /opt/tt-emule-runtime/source-manifest.json

RUN printf '%s  %s\n' "$STACK_MANIFEST_SHA256" \
        /opt/tt-emule-runtime/source-manifest.json | sha256sum --check --strict \
    && /opt/ttlang-toolchain/venv/bin/python -c \
        'import json, sys; keys = ("source_manifest_sha256", "compiler_repository", "compiler_commit", "emulator_commit", "metal_repository", "metal_commit", "base_image", "platform", "target", "cluster_descriptor", "mesh_device"); json.dump(dict(zip(keys, sys.argv[1:])), sys.stdout, indent=2); print()' \
        "$STACK_MANIFEST_SHA256" \
        "$TT_LANG_COMPILER_REPOSITORY" "$TT_LANG_COMPILER_BASE_COMMIT" \
        "$TT_EMULE_COMMIT" \
        "$TT_METAL_SOURCE_URL" "$TT_METAL_COMMIT" \
        "$BASE_IMAGE" "$RUNTIME_PLATFORM" "$TARGET_NAME" \
        "$TARGET_CLUSTER_DESCRIPTOR" "$TARGET_MESH_DEVICE" \
        > /opt/tt-emule-runtime/stack.json

RUN test -f /opt/tt-emule/tt-metal-pin.txt \
    && grep -F -x -- "$TT_METAL_COMMIT" /opt/tt-emule/tt-metal-pin.txt \
    && mkdir -p "$TT_EMULE_RUNTIME_ROOT" \
    && git init "$TT_METAL_SOURCE_DIR" \
    && git -C "$TT_METAL_SOURCE_DIR" remote add origin "$TT_METAL_SOURCE_URL" \
    && git -C "$TT_METAL_SOURCE_DIR" fetch --depth 1 origin "$TT_METAL_COMMIT" \
    && git -C "$TT_METAL_SOURCE_DIR" checkout --detach FETCH_HEAD \
    && git -C "$TT_METAL_SOURCE_DIR" submodule update --init --depth 1 \
        tt_metal/third_party/umd tt_metal/third_party/tracy

RUN cmake -S "$TT_METAL_SOURCE_DIR" -B "$TT_METAL_BUILD_DIR" -G Ninja \
        -DCMAKE_TOOLCHAIN_FILE="$TT_METAL_SOURCE_DIR/cmake/x86_64-linux-clang-20-libstdcpp-toolchain.cmake" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="$TT_METAL_BUILD_DIR" \
        -DPython3_EXECUTABLE=/opt/ttlang-toolchain/venv/bin/python \
        -DTT_METAL_USE_EMULE=ON \
        -DTT_EMULE_PATH=/opt/tt-emule \
        -DWITH_PYTHON_BINDINGS=ON \
        -DTT_UNITY_BUILDS=ON \
        -DENABLE_TRACY=OFF \
        -DENABLE_DISTRIBUTED=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_PROGRAMMING_EXAMPLES=OFF \
        -DTT_METAL_BUILD_TESTS=OFF \
        -DTTNN_BUILD_TESTS=OFF \
        -DBUILD_TT_TRAIN=OFF \
        -DBUILD_TELEMETRY=OFF \
        -DENABLE_TTNN_SHARED_SUBLIBS=OFF \
        -DTT_ENABLE_LIGHT_METAL_TRACE=OFF \
        -DENABLE_LIBCXX=OFF \
    && TT_METAL_HOME="$TT_METAL_SOURCE_DIR" \
       TT_METAL_RUNTIME_ROOT="$TT_METAL_SOURCE_DIR" \
       TT_METAL_CACHE="$TT_METAL_BUILD_DIR/tt-metal-cache" \
       cmake --build "$TT_METAL_BUILD_DIR" --target ttnn ttnncpp --parallel 2 \
    && TT_METAL_HOME="$TT_METAL_SOURCE_DIR" \
       TT_METAL_RUNTIME_ROOT="$TT_METAL_SOURCE_DIR" \
       TT_METAL_CACHE="$TT_METAL_BUILD_DIR/tt-metal-cache" \
       cmake --build "$TT_METAL_BUILD_DIR" --target precompile-fw --parallel 1 \
    && ln -sfn "$TT_METAL_BUILD_DIR/ttnn/_ttnn.so" \
        "$TT_METAL_SOURCE_DIR/ttnn/ttnn/_ttnn.so" \
    && mkdir -p "$TT_METAL_BUILD_DIR/lib" \
    && ln -sfn ../tt_metal/libtt_metal.so "$TT_METAL_BUILD_DIR/lib/libtt_metal.so" \
    && ln -sfn ../tt_stl/libtt_stl.so "$TT_METAL_BUILD_DIR/lib/libtt_stl.so" \
    && ln -sfn ../ttnn/_ttnncpp.so "$TT_METAL_BUILD_DIR/lib/_ttnncpp.so" \
    && ln -sfn ../ttnn/_ttnn.so "$TT_METAL_BUILD_DIR/lib/_ttnn.so" \
    && nm -DC "$TT_METAL_BUILD_DIR/tt_metal/libtt_metal.so" \
        > /tmp/tt-metal-symbols.txt \
    && grep -q 'emule::execute_program_emulated' /tmp/tt-metal-symbols.txt \
    && rm /tmp/tt-metal-symbols.txt \
    && TT_METAL_HOME="$TT_METAL_SOURCE_DIR" \
       TT_METAL_RUNTIME_ROOT="$TT_METAL_SOURCE_DIR" \
       PYTHONPATH="$TT_METAL_SOURCE_DIR/ttnn:$TT_METAL_SOURCE_DIR/tools" \
       /opt/ttlang-toolchain/venv/bin/python -c 'import ttnn'

COPY package-emule-runtime.sh trim-emule-venv.sh /tmp/
COPY --from=tt-lang-stack requirements.txt requirements-runtime.txt requirements-test.txt \
    /runtime/requirements/
RUN mkdir -p /runtime \
    && bash /tmp/package-emule-runtime.sh "$TT_METAL_SOURCE_DIR" /runtime/tt-metal \
    && cp "$TT_EMULE_RUNTIME_ROOT/stack.json" \
          "$TT_EMULE_RUNTIME_ROOT/source-manifest.json" /runtime/ \
    && bash /tmp/trim-emule-venv.sh /opt/ttlang-toolchain/venv/bin/python \
    && /opt/ttlang-toolchain/venv/bin/python -m pip install --no-cache-dir \
        -r /runtime/requirements/requirements-test.txt \
    && /opt/ttlang-toolchain/venv/bin/python -m pip check \
    && rm -f /opt/ttlang-toolchain/bin/tt-triage \
    && rm -f /opt/ttlang-toolchain/venv/bin/python \
        /opt/ttlang-toolchain/venv/bin/python3 \
        /opt/ttlang-toolchain/venv/bin/python3.12

# Use the pinned compiler's Clang, rather than another LLVM SDK from apt.
RUN set -euo pipefail \
    && compiler="$(sed -n 's/^CMAKE_CXX_COMPILER:[^=]*=//p' "$TT_METAL_BUILD_DIR/CMakeCache.txt")" \
    && test -n "$compiler" \
    && compiler="$(readlink -f "$(command -v "$compiler")")" \
    && test -x "$compiler" \
    && llvm_prefix="$(dirname "$(dirname "$compiler")")" \
    && llvm_version="$("$compiler" -dumpversion)" \
    && llvm_major="${llvm_version%%.*}" \
    && [[ "$llvm_major" =~ ^[0-9]+$ ]] \
    && libraries="$(ldd "$compiler" "$llvm_prefix/bin/lld")" \
    && llvm_library="$(printf '%s\n' "$libraries" | awk '$1 ~ /^libLLVM[.-]/ && $2 == "=>" && $3 != "not" { print $3 }' | sort -u)" \
    && clang_library="$(printf '%s\n' "$libraries" | awk '$1 ~ /^libclang-cpp[.-]/ && $2 == "=>" && $3 != "not" { print $3 }' | sort -u)" \
    && test -n "$llvm_library" && test -n "$clang_library" \
    && mkdir -p "/clang$llvm_prefix/bin" "/clang$llvm_prefix/lib" \
        /clang/usr/lib/x86_64-linux-gnu /clang/usr/bin \
    && cp -L "$compiler" "/clang$llvm_prefix/bin/clang" \
    && cp -L "$llvm_prefix/bin/lld" "/clang$llvm_prefix/bin/" \
    && cp -a "$llvm_prefix/lib/clang" "/clang$llvm_prefix/lib/" \
    && cp -L "$llvm_library" "$clang_library" /clang/usr/lib/x86_64-linux-gnu/ \
    && ln -s clang "/clang$llvm_prefix/bin/clang++" \
    && ln -s lld "/clang$llvm_prefix/bin/ld.lld" \
    && for tool in clang clang++ lld ld.lld; do \
        ln -s "$llvm_prefix/bin/$tool" "/clang/usr/bin/$tool-$llvm_major"; \
    done \
    && for package in "clang-$llvm_major" "lld-$llvm_major" "libllvm$llvm_major" \
        "libclang-cpp$llvm_major" "libclang-common-$llvm_major-dev" "libclang-rt-$llvm_major-dev"; do \
        mkdir -p "/clang/usr/share/doc/$package"; \
        cp "/usr/share/doc/$package/copyright" "/clang/usr/share/doc/$package/"; \
    done

FROM ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3 AS runtime
SHELL ["/bin/bash", "-c"]

ARG BASE_IMAGE
ARG STACK_MANIFEST_SHA256
ARG TT_LANG_COMPILER_REPOSITORY
ARG TT_LANG_COMPILER_BASE_COMMIT
ARG TT_EMULE_COMMIT
ARG TT_METAL_COMMIT
ARG TT_METAL_SOURCE_URL
ARG RUNTIME_PLATFORM
ARG TARGET_NAME
ARG TARGET_CLUSTER_DESCRIPTOR
ARG TARGET_MESH_DEVICE

LABEL org.opencontainers.image.title="TT-Lang compiler-backed emule runtime" \
      org.opencontainers.image.source="${TT_LANG_COMPILER_REPOSITORY}" \
      io.tenstorrent.tt-lang.compiler.commit="${TT_LANG_COMPILER_BASE_COMMIT}" \
      io.tenstorrent.tt-lang.emule.commit="${TT_EMULE_COMMIT}" \
      io.tenstorrent.tt-lang.metal.repository="${TT_METAL_SOURCE_URL}" \
      io.tenstorrent.tt-lang.metal.commit="${TT_METAL_COMMIT}" \
      io.tenstorrent.tt-lang.runtime.base-image="${BASE_IMAGE}" \
      io.tenstorrent.tt-lang.runtime.manifest-sha256="${STACK_MANIFEST_SHA256}" \
      io.tenstorrent.tt-lang.runtime.platform="${RUNTIME_PLATFORM}" \
      io.tenstorrent.tt-lang.target.name="${TARGET_NAME}" \
      io.tenstorrent.tt-lang.target.cluster-descriptor="${TARGET_CLUSTER_DESCRIPTOR}" \
      io.tenstorrent.tt-lang.target.mesh-device="${TARGET_MESH_DEVICE}"

ENV DEBIAN_FRONTEND=noninteractive
ENV TT_EMULE_RUNTIME_ROOT=/opt/tt-emule-runtime
ENV TT_METAL_SOURCE_DIR=/opt/tt-emule-runtime/tt-metal
ENV TT_METAL_BUILD_DIR=/opt/tt-emule-runtime/tt-metal/build_emule

RUN apt-get update && apt-get install -y --no-install-recommends \
        binutils ca-certificates cmake g++ gcc git make ninja-build pkg-config \
        python3 python3.12-dev python3.12-venv \
        libedit2 libffi8 libhwloc15 libnuma1 libtinfo6 libxml2-dev \
        libzstd-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /clang/ /
COPY --from=build /opt/ttlang-toolchain/bin /opt/ttlang-toolchain/bin/
COPY --from=build /opt/ttlang-toolchain/include /opt/ttlang-toolchain/include/
COPY --from=build /opt/ttlang-toolchain/lib /opt/ttlang-toolchain/lib/
COPY --from=build /opt/ttlang-toolchain/share /opt/ttlang-toolchain/share/
COPY --from=build /opt/ttlang-toolchain/src /opt/ttlang-toolchain/src/
COPY --from=build /opt/ttlang-toolchain/python_packages /opt/ttlang-toolchain/python_packages/
COPY --from=build /opt/ttlang-toolchain/venv /opt/ttlang-toolchain/venv/
COPY --from=build /runtime/ /opt/tt-emule-runtime/
COPY --from=build /opt/tt-emule /opt/tt-emule/

# Refresh the copied venv's base-interpreter paths for the final OS.
RUN ldconfig \
    && clang-20 --version && ld.lld-20 --version \
    && python3 -m venv --upgrade --without-pip --symlinks --prompt ttlang \
        /opt/ttlang-toolchain/venv \
    && /opt/ttlang-toolchain/venv/bin/python -m pip check \
    && TT_METAL_HOME="$TT_METAL_SOURCE_DIR" \
       TT_METAL_RUNTIME_ROOT="$TT_METAL_SOURCE_DIR" \
       PYTHONPATH="$TT_METAL_SOURCE_DIR/ttnn:$TT_METAL_SOURCE_DIR/tools" \
       /opt/ttlang-toolchain/venv/bin/python -c 'import ttnn, pytest, lit' \
    && mkdir -p /ttlang-build /tt-metal-cache

WORKDIR /workspace
ENTRYPOINT ["/workspace/scripts/tt-lang-emule-entrypoint.sh"]
