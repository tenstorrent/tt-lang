# Auto-generated by CMake - do not edit manually

from pathlib import Path
from typing import Iterable


# Root of the build that produced this package.
BUILD_DIR = Path("@CMAKE_BINARY_DIR@")

# Keep package resources relocatable, including when config.py is a build symlink.
KERNEL_INCLUDE_DIR = Path(__file__).absolute().parent / "@TTLANG_KERNEL_INCLUDE_DIR@"
KERNEL_HEADER_DIR = Path("@TTLANG_KERNEL_HEADER_DIR@")

# Whether a Tenstorrent device was detected at CMake configure time
# CMake sets TTLANG_HAS_DEVICE_INT to 1 or 0
HAS_TT_DEVICE = @TTLANG_HAS_DEVICE_INT@ == 1

# Version string derived from git tags at CMake configure time
VERSION = "@TTLANG_VERSION@"

# Source revisions this wheel was built from; "unknown" without a git checkout
# or the CI build-arg overrides.
TTLANG_COMMIT = "@TTLANG_GIT_COMMIT@"
TT_METAL_TAG = "@TTLANG_TT_METAL_TAG@"
TT_METAL_COMMIT = "@TTLANG_TT_METAL_COMMIT@"


def kernel_include_paths(include_paths: Iterable[str]) -> list[str]:
    """Append packaged kernel headers after caller-supplied override paths."""
    paths = list(include_paths)
    if (KERNEL_INCLUDE_DIR / KERNEL_HEADER_DIR).is_dir():
        paths.append(str(KERNEL_INCLUDE_DIR))
    return paths
