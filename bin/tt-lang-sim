#!/usr/bin/env bash
# SPDX-FileCopyrightText: (c) 2025 Tenstorrent AI ULC
#
# SPDX-License-Identifier: Apache-2.0
# TT-Lang Simulator launcher (tt-lang-sim)
#
# Runs tt-lang kernels on a simulator backend without code changes.
# Usage: tt-lang-sim <file.py|module> [args...] [--backend python|emule]

PYTHON="${PYTHON:-python}"

# Resolve the repo/toolchain root from the script's own location so this works
# when invoked as ./bin/tt-lang-sim or from an arbitrary working directory.
_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_REPO_ROOT="$(dirname "$_SCRIPT_DIR")"
_EMULE_CLI="${_REPO_ROOT}/scripts/tt-lang-emule.py"

# Extract the launcher-owned option before forwarding the remaining arguments.
# The simulator CLI already uses `--` to separate its options from script
# arguments, so stop scanning there as well.
_BACKEND="${TTLANG_SIM_BACKEND:-python}"
_RUNTIME_IMAGE=""
_SMOKE_TEST=0
_ACTION=""
_FORWARD_ARGS=()
_SEPARATOR_INDEX=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --backend)
            if [ "$#" -lt 2 ]; then
                echo "tt-lang-sim: --backend requires python or emule." >&2
                exit 2
            fi
            _BACKEND="$2"
            shift 2
            ;;
        --backend=*)
            _BACKEND="${1#--backend=}"
            shift
            ;;
        --runtime-image)
            if [ "$#" -lt 2 ]; then
                echo "tt-lang-sim: --runtime-image requires an image reference." >&2
                exit 2
            fi
            _RUNTIME_IMAGE="$2"
            shift 2
            ;;
        --runtime-image=*)
            _RUNTIME_IMAGE="${1#--runtime-image=}"
            if [ -z "$_RUNTIME_IMAGE" ]; then
                echo "tt-lang-sim: --runtime-image requires an image reference." >&2
                exit 2
            fi
            shift
            ;;
        --setup|--test|--examples|--smoke-test)
            if [ -n "$_ACTION" ]; then
                echo "tt-lang-sim: --setup, --test, --examples, and --smoke-test are mutually exclusive." >&2
                exit 2
            fi
            _ACTION="$1"
            if [ "$_ACTION" = "--smoke-test" ]; then
                _SMOKE_TEST=1
            fi
            shift
            ;;
        --)
            _SEPARATOR_INDEX="${#_FORWARD_ARGS[@]}"
            _FORWARD_ARGS+=("$@")
            break
            ;;
        *)
            _FORWARD_ARGS+=("$1")
            shift
            ;;
    esac
done
set -- "${_FORWARD_ARGS[@]}"

# Help and version describe the launcher as a whole and never require a
# backend runtime. Preserve the existing no-argument help path as well.
if [ -z "$_ACTION" ]; then
    case "${1:-}" in
        ""|-h|--help|--version)
            _BACKEND=python
            ;;
    esac
fi

if [ "$_BACKEND" != "emule" ] && \
   { [ -n "$_RUNTIME_IMAGE" ] || [ -n "$_ACTION" ]; }; then
    echo "tt-lang-sim: --runtime-image, --setup, --test, --examples, and --smoke-test require --backend emule." >&2
    exit 2
fi

if [ "$_BACKEND" = "emule" ]; then
    if [ -n "$_RUNTIME_IMAGE" ]; then
        export TTLANG_EMULE_IMAGE="$_RUNTIME_IMAGE"
    fi
    if [ -n "$_ACTION" ] && \
       { [ "$_ACTION" != "--smoke-test" ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; }; then
        if [ ! -f "$_EMULE_CLI" ]; then
            echo "tt-lang-sim: ${_ACTION} requires a source checkout." >&2
            exit 1
        fi
        exec "${TTLANG_EMULE_HOST_PYTHON:-python3}" "$_EMULE_CLI" "$_ACTION" "$@"
    fi
    if [ "$_SMOKE_TEST" -eq 1 ]; then
        if [ "$#" -ne 0 ]; then
            echo "tt-lang-sim: --smoke-test does not accept a script." >&2
            exit 2
        fi
        set -- "${_REPO_ROOT}/examples/compiler_only_external_call.py"
    fi
    # Unlike the Python backend, emule has no intermediate argparse layer to
    # consume the launcher/script separator before invoking the user program.
    if [ -n "$_SEPARATOR_INDEX" ]; then
        _EMULE_FORWARD_ARGS=()
        _ARG_INDEX=0
        for _ARGUMENT in "$@"; do
            if [ "$_ARG_INDEX" -ne "$_SEPARATOR_INDEX" ]; then
                _EMULE_FORWARD_ARGS+=("$_ARGUMENT")
            fi
            _ARG_INDEX=$((_ARG_INDEX + 1))
        done
        set -- "${_EMULE_FORWARD_ARGS[@]}"
    fi

    if [ -n "${TTLANG_EMULE_RUNNER:-}" ]; then
        _EMULE_RUNNER="$TTLANG_EMULE_RUNNER"
    else
        _EMULE_RUNNER="${_REPO_ROOT}/scripts/tt-lang-emule-container.sh"
    fi

    if [ ! -x "$_EMULE_RUNNER" ]; then
        echo "tt-lang-sim: cannot locate the tt-emule runner." >&2
        echo "  expected: ${_EMULE_RUNNER}" >&2
        echo "  The emule backend currently requires a tt-lang source checkout." >&2
        exit 1
    fi

    if [ -f "$_EMULE_CLI" ]; then
        exec "${TTLANG_EMULE_HOST_PYTHON:-python3}" "$_EMULE_CLI" \
            --launch "$_EMULE_RUNNER" "$@"
    fi
    exec "$_EMULE_RUNNER" "$@"
fi

if [ "$_BACKEND" != "python" ]; then
    echo "tt-lang-sim: unknown backend '${_BACKEND}'; expected python or emule." >&2
    exit 2
fi

# Sources: python/sim; installed ttlang: python_packages/ttl/sim.
if [ -f "${_REPO_ROOT}/python/sim/ttlang_sim.py" ]; then
    export PYTHONPATH="${_REPO_ROOT}/python${PYTHONPATH:+:${PYTHONPATH}}"
    exec "$PYTHON" -m sim.ttlang_sim "$@"
fi

if [ -f "${_REPO_ROOT}/python_packages/ttl/sim/ttlang_sim.py" ]; then
    export PYTHONPATH="${_REPO_ROOT}/python_packages${PYTHONPATH:+:${PYTHONPATH}}"
    exec "$PYTHON" -m ttl.sim.ttlang_sim "$@"
fi

echo "tt-lang-sim: cannot locate the sim package." >&2
echo "  checked: ${_REPO_ROOT}/python/sim/ttlang_sim.py (source tree)" >&2
echo "  checked: ${_REPO_ROOT}/python_packages/ttl/sim/ttlang_sim.py (installed)" >&2
exit 1
